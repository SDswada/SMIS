{
  "name": "sims",
  "version": "1.0.0",
  "description": "Sistem Informasi Manajemen Sekolah - Production Ready School Management System",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --require ts-node/register prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "generate": "prisma generate",
    "prepare": "husky install",
    "check:ci": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@tanstack/react-query": "^5.28.0",
    "@tanstack/react-table": "^8.13.0",
    "react-hook-form": "^7.48.0",
    "zod": "^3.22.4",
    "@hookform/resolvers": "^3.3.4",
    "axios": "^1.6.0",
    "next-auth": "^4.24.0",
    "bcryptjs": "^2.4.3",
    "argon2": "^0.31.1",
    "jsonwebtoken": "^9.1.0",
    "@prisma/client": "^5.7.0",
    "tailwindcss": "^3.4.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.2.0",
    "shadcn-ui": "^0.8.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-slot": "^2.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-popover": "^1.0.7",
    "lucide-react": "^0.294.0",
    "pdfkit": "^0.13.0",
    "xlsx": "^0.18.5",
    "csv-parse": "^5.5.0",
    "csv-stringify": "^6.4.0",
    "nodemailer": "^6.9.7",
    "sharp": "^0.33.0",
    "uuid": "^9.0.1",
    "date-fns": "^2.30.0",
    "lodash-es": "^4.17.21",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.1.5",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.38",
    "@types/react-dom": "^18.2.16",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.12.11",
    "typescript": "^5.3.3",
    "prisma": "^5.7.0",
    "@prisma/internals": "^5.7.0",
    "vitest": "^1.0.4",
    "@vitest/ui": "^1.0.4",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.1.5",
    "playwright": "^1.40.0",
    "@playwright/test": "^1.40.0",
    "prettier": "^3.1.0",
    "eslint": "^8.55.0",
    "eslint-config-next": "^14.0.0",
    "ts-node": "^10.9.2",
    "@types/express": "^4.17.21",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.0"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write",
      "git add"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
