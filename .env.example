# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SIMS
NEXT_PUBLIC_APP_DESCRIPTION=Sistem Informasi Manajemen Sekolah

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/sims

# Authentication
AUTH_SECRET=your-super-secret-key-change-in-production
AUTH_SALT=your-auth-salt-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRE=7d

# Email
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@sekolah.local

# Storage
STORAGE_PROVIDER=local
STORAGE_PATH=./public/uploads

# AI
AI_PROVIDER=openai
AI_API_KEY=your-api-key
AI_MODEL=gpt-4-turbo-preview

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Redis (optional for caching/queue)
REDIS_URL=redis://localhost:6379

# Security
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
